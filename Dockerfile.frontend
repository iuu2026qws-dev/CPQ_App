# CPQ App 前端 — 双应用构建（cpq-portal + ruoyi-ui）→ Nginx
# 构建上下文：项目根目录

# Stage 1: 构建 cpq-portal
FROM node:22-alpine AS portal-builder
WORKDIR /app
COPY cpq-portal/package*.json ./
RUN npm install --ignore-engines --legacy-peer-deps
COPY cpq-portal/ .
RUN npm run build

# Stage 2: 构建 ruoyi-ui
FROM node:22-alpine AS admin-builder
WORKDIR /app
COPY ruoyi-ui/package*.json ./
RUN npm install --ignore-engines --legacy-peer-deps
COPY ruoyi-ui/ .
RUN npm run build

# Stage 3: Nginx 双端口服务
FROM nginx:1.26-alpine
COPY --from=portal-builder /app/dist /usr/share/nginx/html/portal
COPY --from=admin-builder /app/dist /usr/share/nginx/html/admin
COPY nginx.frontend.conf /etc/nginx/conf.d/default.conf
EXPOSE 80 5173
CMD ["nginx", "-g", "daemon off;"]
